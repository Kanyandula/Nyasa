    {
      "type": "text", "id": "secC_a2_code",
      "x": 840, "y": 632, "width": 720, "height": 125,
      "text": "abstract class BaseViewModel<S : ViewState> : ViewModel() {\n    val uiState:   StateFlow<S>\n    val isLoading: StateFlow<Boolean>\n    val events:    SharedFlow<UiEvent>\n}\n// UiEvent = ShowToast | ShowErrorDialog | ShowSuccessDialog",
      "originalText": "abstract class BaseViewModel<S : ViewState> : ViewModel() {\n    val uiState:   StateFlow<S>\n    val isLoading: StateFlow<Boolean>\n    val events:    SharedFlow<UiEvent>\n}\n// UiEvent = ShowToast | ShowErrorDialog | ShowSuccessDialog",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#a7f3d0", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
