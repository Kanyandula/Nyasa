    {
      "type": "text", "id": "secC_a1_code",
      "x": 840, "y": 460, "width": 720, "height": 100,
      "text": "sealed class Resource<T> {\n    object Loading : Resource<Nothing>()\n    data class Success<T>(val data: T) : Resource<T>()\n    data class Error(val message: String) : Resource<Nothing>()\n}",
      "originalText": "sealed class Resource<T> {\n    object Loading : Resource<Nothing>()\n    data class Success<T>(val data: T) : Resource<T>()\n    data class Error(val message: String) : Resource<Nothing>()\n}",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#a7f3d0", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
